{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021", "DOM"],
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@resources/*": ["resources/*"],
      "@lib/*": ["lib/*"],
      "@fixtures/*": ["fixtures/*"]
    }
  },
  "include": ["tests", "resources", "lib", "fixtures", "playwright.config.ts"]
}
