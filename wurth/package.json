{
  "name": "wurth-storefront-ui-tests",
  "version": "1.0.0",
  "description": "Playwright + TypeScript UI automation for the Wurth Kosovo storefront",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test tests/ui/storefront/suites/smoke",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "typescript": "^5.6.0"
  }
}
